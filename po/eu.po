#: data/metainfo/catfish.appdata.xml.in:8
msgid "Versatile file searching tool"
msgstr "Fitxategiak bilatzeko tresna moldakorra"

#: data/metainfo/catfish.appdata.xml.in:11
msgid ""
"Catfish is a small, fast, and powerful file search utility. Featuring a "
"minimal interface with an emphasis on results, it helps users find the files"
" they need without a file manager. With powerful filters such as "
"modification date, file type, and file contents, users will no longer be "
"dependent on the file manager or organization skills."
msgstr ""
"Catfish fitxategiak bilatzeko tresna txikia, azkarra eta ahaltsua da. "
"Emaitzetan oinarritutako interfaze minimoarekin, erabiltzaileei behar "
"dituzten fitxategiak aurkitzen laguntzen die fitxategi-kudeatzailerik gabe. "
"Aldaketa-data, fitxategi mota eta fitxategien edukia bezalako iragazki "
"ahaltsuei esker, erabiltzaileek ez dute jada fitxategi-kudeatzailearen edo "
"antolatzeko trebetasunen menpe egon beharko."

#: data/metainfo/catfish.appdata.xml.in:25
